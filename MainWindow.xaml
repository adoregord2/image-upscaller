<Window x:Class="ImageUpscaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ImageUpscaller.Models"
        Title="Image Upscaller" Height="820" Width="1120" MinHeight="820" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F7F4">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="IMAGE UPSCALLER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Text="Upscale locally. Keep your images yours." Margin="0,7,0,0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
        <TextBlock Text="On-device image enhancement · Works offline" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" />
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,7" CornerRadius="14" Background="#E7F1EB">
        <TextBlock Text="●  LOCAL PROCESSING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="White" BorderBrush="#E1E7E2" BorderThickness="1" CornerRadius="14">
      <Grid Margin="22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="YOUR IMAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
          <Button x:Name="ChooseImageButton" Content="Choose an image" Height="46" Margin="0,12,0,0" Click="ChooseImage_Click" />
          <TextBlock x:Name="FileNameText" Text="{Binding ImageSummary}" Margin="0,9,0,20" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

          <TextBlock Text="OUTPUT SCALE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
          <ComboBox x:Name="ScaleComboBox" SelectedValue="{Binding SelectedScale, Mode=TwoWay}" SelectedValuePath="Tag" Height="42" Margin="0,10,0,0" FontSize="14" HorizontalContentAlignment="Center">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBoxItem Content="2×  ·  Smaller file" Tag="{x:Static models:UpscaleScale.X2}" />
            <ComboBoxItem Content="4×  ·  Recommended" Tag="{x:Static models:UpscaleScale.X4}" />
          </ComboBox>

          <TextBlock Text="Upscaling runs on this computer. Large images may take longer." Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock Text="OUTPUT FORMAT" Margin="0,18,0,0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
          <ComboBox x:Name="CompressionComboBox" SelectedValue="{Binding SelectedOutputFormat, Mode=TwoWay}" SelectedValuePath="Tag" Height="40" Margin="0,8,0,0" FontSize="13" HorizontalContentAlignment="Center" ToolTip="Choose a high-quality format or optionally target about 10 MB with AVIF.">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBoxItem Content="None · PNG (original quality)" Tag="{x:Static models:OutputFormat.Png}" />
            <ComboBoxItem Content="WebP · High quality (lossy)" Tag="{x:Static models:OutputFormat.Webp}" />
            <ComboBoxItem Content="AVIF · High quality" Tag="{x:Static models:OutputFormat.AvifQuality}" />
            <ComboBoxItem Content="AVIF · Target about 10 MB" Tag="{x:Static models:OutputFormat.AvifTargetSize}" />
          </ComboBox>
          <Button x:Name="UpscaleButton" Content="Upscale image" Height="48" Margin="0,10,0,0" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Click="Upscale_Click" IsEnabled="False" />
          <Button x:Name="CancelButton" Content="Cancel" Height="38" Margin="0,8,0,0" Click="Cancel_Click" IsEnabled="False" />
          <Button x:Name="CompareButton" Content="Show original" Height="38" Margin="0,8,0,0" Click="Compare_Click" IsEnabled="False" />

          <ProgressBar x:Name="WorkProgress" Height="5" Margin="0,18,0,0" Minimum="0" Maximum="100" />
          <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock x:Name="EngineText" Text="{Binding EngineMessage}" Margin="0,18,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Column="2" Background="#F0F3F0" CornerRadius="10" ClipToBounds="True">
          <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10" />
            <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock Text="＋" HorizontalAlignment="Center" FontSize="36" Foreground="#9AA79F" />
              <TextBlock Text="Your image preview will appear here" FontSize="14" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14" Padding="9,5" Background="#E6FFFFFF" CornerRadius="5">
              <TextBlock x:Name="PreviewLabel" Text="ORIGINAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <DockPanel Grid.Row="2" Margin="2,15,2,0">
      <TextBlock Text="PNG / JPEG / WebP / AVIF input  ·  PNG, WebP, or AVIF output" FontSize="11" Foreground="{StaticResource MutedBrush}" />
      <TextBlock Text="Model files stay on your device" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" />
    </DockPanel>
  </Grid>
</Window>
